# Database - Configuração para Docker (usar nomes dos serviços)
POSTGRES_DB=worksafety
POSTGRES_USER=worksafety
POSTGRES_PASSWORD=worksafety
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL usando o hostname do container PostgreSQL
DATABASE_URL=postgres://worksafety:worksafety@db:5432/worksafety

# Django
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Reset de senha
PASSWORD_RESET_TIMEOUT=3600

# Email (modo console para desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@worksafety.local

# Celery / Redis - usando hostname do container Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# AI Service Configuration (mock mode para desenvolvimento)
AI_SERVICE_ENABLED=true
AI_SERVICE_MOCK_MODE=true
AI_SERVICE_TIMEOUT=30
