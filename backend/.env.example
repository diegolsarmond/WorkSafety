# Database (used by docker-compose and local runs)
POSTGRES_DB=worksafety
POSTGRES_USER=worksafety
POSTGRES_PASSWORD=worksafety
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Or use a single URL (overrides POSTGRES_* when set)
# DATABASE_URL=postgres://worksafety:worksafety@localhost:5432/worksafety

# Django
SECRET_KEY=your-secret-key-here
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Reset de senha (F17.4)
PASSWORD_RESET_TIMEOUT=3600

# Segurança produção (F4.4) — usar com reverse proxy TLS
# SECURE_HTTPS=1

# Email (MVP: console; produção: configurar backend)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@worksafety.local

# Celery / Redis (para processamento assíncrono)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Service Configuration
AI_SERVICE_ENABLED=true
AI_SERVICE_MOCK_MODE=true
AI_SERVICE_TIMEOUT=30
# AI_SERVICE_BASE_URL=https://ai-service.example.com
# AI_SERVICE_API_KEY=your-api-key
