# ============================================================================
# WorkSafety Backend - Production Environment Configuration
# ============================================================================

# Database Configuration
POSTGRES_DB=worksafety
POSTGRES_USER=worksafety
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Settings
SECRET_KEY=change_me_to_a_secure_random_key_in_production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,200.152.38.136,200.152.47.9,inovacao.dataprev.gov.br

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Account Lockout Configuration
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Password Reset Timeout (in seconds)
PASSWORD_RESET_TIMEOUT=3600

# Security Configuration for Production
# When using HTTPS reverse proxy (Nginx with TLS)
SECURE_HTTPS=1
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Celery / Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# AI Service Configuration
AI_SERVICE_ENABLED=true
AI_SERVICE_MOCK_MODE=false
AI_SERVICE_TIMEOUT=30

# Media URL prefix (must match the reverse proxy path)
MEDIA_URL=/worksafety/media/

# Olímpia API Configuration (Dataprev Integration)
OLIMPIA_API_ENABLED=true
# OLIMPIA_API_BASE_URL=https://api.dataprev.gov.br/olimpia/
# OLIMPIA_API_KEY=your-api-key-here

# Email Configuration
# Configure your email backend for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@worksafety.dataprev.gov.br

# Logging Configuration
LOG_LEVEL=INFO
